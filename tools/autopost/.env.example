# Скопируйте в .env и заполните. Без .env сервис работает в тестовом режиме только если AUTOPOST_DRY=1.

# 1 — тестовый режим: очередь, проверки и статусы настоящие, но на площадки ничего не уходит.
AUTOPOST_DRY=1
PORT=4777

# Прокси для площадок, закрытых из РФ (Instagram, TikTok, при нужде YouTube). Встроено в Node 24+, библиотек не нужно.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@proxy-host:port
# VK — напрямую, мимо прокси:
# NO_PROXY=vk.com,api.vk.com,id.vk.com,userapi.com,vkuser.net,localhost,127.0.0.1

# YouTube: Google Cloud → APIs & Services → YouTube Data API v3 → Credentials → OAuth client «Desktop app».
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# 0 — не ставить пометку «синтетический контент» (музыка и видео группы сделаны нейросетями — по умолчанию ставим).
# YT_SYNTHETIC=1

# VK: ключ сообщества вставляется в кабинете; id сообщества можно задать здесь.
# VK_GROUP_ID=

# TikTok: developers.tiktok.com → приложение, платформа Desktop, адрес http://localhost:4777/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# Instagram: ключ вставляется в кабинете («Площадки»). Версия Graph API:
# IG_API_VERSION=v24.0

# Публичная папка для файлов (Instagram забирает ролики и картинки по ссылке):
# MEDIA_SCP_TARGET=gcanalitics:/var/www/oskolki-media/
# MEDIA_PUBLIC_URL=https://oskolkihaosa.ru/m/

# Уведомления в Telegram: свой бот (@BotFather) и чат, куда он добавлен (личка или группа участников).
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# Ключ шифрования ключей площадок (64 hex). Не задан — создаётся data/secret.key.
# SECRET_KEY=
