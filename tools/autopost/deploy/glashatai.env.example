# /etc/glashatai.env (chmod 640 root:glashatai). Ключи площадок сюда не пишем — их вставляют в кабинете.
PORT=3400
HOST=127.0.0.1
PUBLIC_URL=https://glashatai.oskolkihaosa.ru
AUTOPOST_DATA=/var/lib/glashatai
AUTOPOST_DRY=1
# 64 hex: openssl rand -hex 32
SECRET_KEY=
MEDIA_SCP_TARGET=/var/www/glashatai-media/
MEDIA_PUBLIC_URL=https://glashatai.oskolkihaosa.ru/m/
# Прокси для Instagram/TikTok (зарубежный). VK, Telegram-уведомления и YouTube — как пойдёт; при сбоях убрать из NO_PROXY.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@host:port
# NO_PROXY=vk.com,api.vk.com,userapi.com,vkuser.net,localhost,127.0.0.1,oskolkihaosa.ru
