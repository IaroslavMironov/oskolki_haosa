# /etc/glashatai.env (chmod 640 root:glashatai). Ключи площадок сюда не пишем — их вставляют в кабинете.
PORT=3400
HOST=127.0.0.1
PUBLIC_URL=https://glashatai.oskolkihaosa.ru
AUTOPOST_DATA=/var/lib/glashatai
AUTOPOST_DRY=1
# 64 hex: openssl rand -hex 32
SECRET_KEY=
MEDIA_SCP_TARGET=/var/www/glashatai-media/
MEDIA_PUBLIC_URL=https://glashatai.oskolkihaosa.ru/m/
# Прокси — общий с другими проектами на сервере (зарубежный, http): адрес задаётся на сервере, в репозиторий не попадает.
# Через него — Telegram, Instagram, TikTok и YouTube (из России закрыты или замедлены). Напрямую — только VK и Яндекс (Метрика).
NODE_USE_ENV_PROXY=1
HTTPS_PROXY=
NO_PROXY=vk.com,vk.ru,userapi.com,vkuser.net,yandex.net,yandex.ru,localhost,127.0.0.1,oskolkihaosa.ru
